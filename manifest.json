{
  "name": "HTSP",
  "version": "3.5.0",
  "manifest_version": 3,
  "description": "Help Tools Side Panel",
  "host_permissions": [
    "*://*.openai.com/*",
    "*://*.chatgpt.com/*",
    "*://*.google.com/*",
    "*://*.googleusercontent.com/*",
    "https://www.googletagmanager.com/*",
    "*://*.gstatic.com/*",
    "*://accounts.google.com/*",
    "*://gemini.google.com/*",
    "*://chat.googleapis.com/*",
    "<all_urls>"
  ],
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "sidePanel",
    "tabs",
    "tabGroups",
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "debugger",
    "management"
  ],
  "icons": {
    "128": "images/icon.png",
    "16": "images/icon.png"
  },
  "action": {
    "default_title": "HTSP"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html",
    "minimum_width": 324
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://*.openai.com/ https://*.chatgpt.com/ https://chatgpt.com/ https://gemini.google.com/ https://accounts.google.com/ https://www.google.com/;"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*", "https://mail.google.com/*"],
      "js": ["read-receipt-blocker/content-script-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.google.com/*", "https://mail.google.com/*"],
      "js": ["read-receipt-blocker/content-script-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
